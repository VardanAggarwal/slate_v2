# LLM provider chain, tried in order (see PLAN.md §6 — port chain from old engine)
# 'openrouter' = primary rung, one key routes to many underlying models with
# its own failover (needs OPENROUTER_API_KEY from openrouter.ai).
# 'claude-cli' = Claude Code CLI billing the Max/Pro subscription (needs
# CLAUDE_CODE_OAUTH_TOKEN from `claude setup-token`); API keys are the fallback.
LLM_FALLBACK_ORDER=openrouter,claude-cli,claude,gemini
OPENROUTER_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Model tiers (PLAN.md §2.11): haiku-class for mechanical work, sonnet-class for merge/split
CLAUDE_MODEL_MECHANICAL=claude-haiku-4-5
CLAUDE_MODEL_JUDGMENT=claude-sonnet-4-6
# OpenRouter model slugs (provider-prefixed)
OPENROUTER_MODEL_MECHANICAL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL_JUDGMENT=nvidia/nemotron-3-super-120b-a12b:free
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# Embeddings: set HF_TOKEN in production → HF Inference API (no torch on the
# server, v1 pattern). Leave empty in dev → local SentenceTransformer.
HF_TOKEN=

# Storage
DB_PATH=data/engine.db

# Encode-time receipt thresholds (cosine similarity)
ECHO_THRESHOLD=0.72
NOVELTY_THRESHOLD=0.55
SENT_MIN_CHARS=40

# Contradiction detection (PLAN.md §9.1):
#   nli   — local cross-encoder, needs torch. DEV ONLY.
#   hf    — HF Inference API zero-shot MNLI, no torch. **USE THIS ON THE SERVER.**
#   haiku — one LLM call per stance   |   off — disabled (tests)
# The server image has no torch, so leaving this at `nli` makes _get_nli() throw,
# degrade to "neutral", and file every contradiction as an echo — silently.
STANCE_PROVIDER=nli
NLI_MODEL=cross-encoder/nli-deberta-v3-small
STANCE_HF_MODEL=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli
STANCE_HF_TIMEOUT=30

# Evidence lane (docs/evidence-lane-plan.md): external sources saved as episodes
# with source='research'. This flag gates the GRAPH + RETRIEVAL half (concept
# membership kind, the nightly stance sweep, recall's 📎/⚡ labels + budget
# partition). The save path is inert without a research episode, so it needs no flag.
# The sweep REFUSES to run on STANCE_PROVIDER=haiku — it bills per pair.
#
# 0 here is the LOCAL/dev default only. PRODUCTION runs it ON: docker-compose.yml
# sets EVIDENCE_LANE=${EVIDENCE_LANE:-1} in `environment:`, which overrides this
# file — deliberately, so re-copying this example can never ship the lane disabled.
# To roll prod back, set EVIDENCE_LANE=0 in the SERVER's .env (the ${:-1} reads it).
EVIDENCE_LANE=0
EVIDENCE_SHARE=0.20              # share of the assemble_context specifics budget
EVIDENCE_SWEEP_MAX_PAIRS=2000    # per-run cap; what it defers is logged, never silent

# Old corpus for migrate.py replay
SLATE_V1_DB=/Users/vardanaggarwal/slate/data/slate.db

# Auth (AUTH.md): users live in the `users` table (cli user add <name>).
# AUTH_USER/AUTH_PASS plays two roles: (1) setting it ENABLES OAuth on /mcp —
# NEVER remove it in production or the MCP endpoint runs unauthenticated;
# (2) it bootstraps the FIRST admin — the first login matching this pair
# auto-provisions that user row. Once any user row exists, the pair's
# credential role is dead (logins validate against the users table only),
# but the variables must stay set to keep auth switched on.
AUTH_USER=
AUTH_PASS=
# Corpus owner when no auth is configured at all (local dev / CLI default)
DEFAULT_USER_ID=local
