# LLM provider chain, tried in order (see PLAN.md §6 — port chain from old engine)
# 'claude-cli' = Claude Code CLI billing the Max/Pro subscription (needs
# CLAUDE_CODE_OAUTH_TOKEN from `claude setup-token`); API keys are the fallback.
LLM_FALLBACK_ORDER=claude-cli,claude,gemini
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Model tiers (PLAN.md §2.11): haiku-class for mechanical work, sonnet-class for merge/split
CLAUDE_MODEL_MECHANICAL=claude-haiku-4-5
CLAUDE_MODEL_JUDGMENT=claude-sonnet-4-6
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# Embeddings: set HF_TOKEN in production → HF Inference API (no torch on the
# server, v1 pattern). Leave empty in dev → local SentenceTransformer.
HF_TOKEN=

# Storage
DB_PATH=data/engine.db

# Encode-time receipt thresholds (cosine similarity)
ECHO_THRESHOLD=0.72
NOVELTY_THRESHOLD=0.55
SENT_MIN_CHARS=40

# Contradiction detection (PLAN.md §9.1): nli (local cross-encoder) | haiku | off
STANCE_PROVIDER=nli
NLI_MODEL=cross-encoder/nli-deberta-v3-small

# Old corpus for migrate.py replay
SLATE_V1_DB=/Users/vardanaggarwal/slate/data/slate.db

# Auth (AUTH.md): users live in the `users` table (cli user add <name>).
# AUTH_USER/AUTH_PASS plays two roles: (1) setting it ENABLES OAuth on /mcp —
# NEVER remove it in production or the MCP endpoint runs unauthenticated;
# (2) it bootstraps the FIRST admin — the first login matching this pair
# auto-provisions that user row. Once any user row exists, the pair's
# credential role is dead (logins validate against the users table only),
# but the variables must stay set to keep auth switched on.
AUTH_USER=
AUTH_PASS=
# Corpus owner when no auth is configured at all (local dev / CLI default)
DEFAULT_USER_ID=local
